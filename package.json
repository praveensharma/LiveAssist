{
  "name": "liveassist",
  "version": "0.1.0",
  "description": "Claude-powered chat assistant embedded in Ableton Live",
  "type": "module",
  "main": "dist/extension.js",
  "scripts": {
    "build": "tsc --noEmit && tsx build.ts --production",
    "package": "npm run build && extensions-cli package -o dist/liveassist.ablx -i dist/ui",
    "prestart": "pkill -f ExtensionHostNodeModule.node || true",
    "start": "tsx build.ts && extensions-cli run",
    "typecheck": "tsc --noEmit",
    "generate": "node --import=tsx/esm scripts/generate-tools.ts",
    "dev:ui": "vite --config ui/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "ableton",
    "live",
    "ai",
    "agent",
    "extension",
    "claude",
    "anthropic"
  ],
  "license": "MIT",
  "dependencies": {
    "@ableton-extensions/sdk": "file:./vendor/ableton-extensions-sdk-1.0.0-beta.0.tgz",
    "@anthropic-ai/sdk": "^0.68.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "lucide-react": "^1.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.0",
    "undici": "^7.28.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@ableton-extensions/cli": "file:./vendor/ableton-extensions-cli-1.0.0-beta.0.tgz",
    "@types/node": "^22.15.29",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.2",
    "esbuild": "^0.28.0",
    "ts-morph": "^28.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
